{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "redirects": [
    { "source": "/houston-hotel-deals", "destination": "/", "permanent": true },
    { "source": "/houston-tx-rooms",    "destination": "/", "permanent": true },
    { "source": "/amenities",           "destination": "/", "permanent": true },
    { "source": "/packages",            "destination": "/", "permanent": true },
    { "source": "/explore",             "destination": "/", "permanent": true },
    { "source": "/photos",              "destination": "/", "permanent": true },
    { "source": "/contact",             "destination": "/", "permanent": true },
    { "source": "/houston-events-venue", "destination": "/", "permanent": true },
    { "source": "/search",              "destination": "/", "permanent": true },
    { "source": "/blog",                "destination": "/", "permanent": true }
  ]
}
